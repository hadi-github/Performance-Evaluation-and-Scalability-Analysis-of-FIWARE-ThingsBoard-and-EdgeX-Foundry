.env
deploy/*/.env

# raw results stay out of git; amendment files next to runs are versioned (never edit raw results or manifests)
results/**
!results/feasible-campaign-20261106/
results/feasible-campaign-20261106/*
!results/feasible-campaign-20261106/run-feasible-campaign.py
!results/feasible-campaign-20261106/operational-ready.md
!results/feasible-campaign-20261106/README.md
!results/feasible-campaign-20261106/PLAN.md
!results/feasible-campaign-20261106/frozen-scope.json
!results/feasible-campaign-20261106/run-matrix.json
!results/feasible-campaign-20261106/scope-matrix.md
!results/feasible-campaign-20261106/make-cell-plans.py
!results/feasible-campaign-20261106/qualify-endpoint.py
!results/feasible-campaign-20261106/qualification*-plan.json
!results/feasible-campaign-20261106/*-final-short-plan.json
# Owner-amended supplemental attempts: the B0 launcher reads this to authorise
# r04a/r04b, so a clone without it cannot validate those cells (found 2026-11-14
# when a fresh clone failed 2 tests that pass on the authoring machine).
!results/feasible-campaign-20261106/supplemental-attempts-*.json
!results/feasible-campaign-20261106/plans/
results/feasible-campaign-20261106/plans/*
!results/feasible-campaign-20261106/plans/*.json
!results/**/
!results/**/*.amendment.json
workloads/**/results/

# generated executables stay out of git
bin/*
!bin/.gitkeep
/benchctl

__pycache__/
*.pyc

# local documentation skill/handbook for agents
/DOCUMENTING.md
/HANDJOB.md

# local agent configuration (no credentials in git)
/opencode.jsonc

# local generated documentation catalogue
/DOCUMENTATION-CATALOG.local.md

# raw campaign evidence belongs on a separate evidence branch
/results/feasible-campaign-20261106/evidence/
