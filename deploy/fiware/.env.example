# ---- versions (identical at every replica count)
ORION_VERSION=4.5.0
IOTA_VERSION=3.7.0
MONGO_VERSION=8.0
HAPROXY_VERSION=3.2-alpine

# ---- scaling: number of platform instances (one orion + one iot-agent each). Use `make up N=4`, which also
# sets POOL_CPUSET; the values here only apply when running docker compose by hand.
FIWARE_REPLICAS=1
POOL_CPUSET=4

# ---- fixed resources (README, "Resource layout"). One instance = 1 core of the pool + ORION_MEM + IOTA_MEM.
LB_CPUSET=1
INFRA_CPUSET=2-3
ORION_MEM=512m
IOTA_MEM=512m
LB_MEM=256m
MONGO_MEM=2g
# WiredTiger cache must stay well below MONGO_MEM (MongoDB also uses memory outside the cache).
MONGO_WT_CACHE_GB=1

# ---- tuning knobs recorded in every run manifest
# Orion defaults are reqPoolSize=0 (thread per request) and dbPoolSize=10; perf_tuning.md suggests
# reqPoolSize ~= CPU cores per replica. Treat as a pilot-tuned parameter, then freeze it.
ORION_REQ_POOL_SIZE=0
ORION_DB_POOL_SIZE=10
ORION_LOG_LEVEL=WARN
IOTA_LOG_LEVEL=WARN
FIWARE_SERVICE=openiot

# ---- exposure
BIND_IP=0.0.0.0
ORION_PORT=1026
IOTA_NORTH_PORT=4041
IOTA_HTTP_PORT=7896
LB_STATS_PORT=8404
