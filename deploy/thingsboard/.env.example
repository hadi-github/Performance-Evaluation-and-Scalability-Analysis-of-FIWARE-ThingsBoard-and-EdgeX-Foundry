# ---- versions (ThingsBoard 4.3.x = last Apache-2.0 line; 4.4 moved to BUSL 1.1)
TB_VERSION=4.3.1.6
POSTGRES_VERSION=16
KAFKA_VERSION=4.0.0
ZOOKEEPER_VERSION=3.8.1
VALKEY_VERSION=8.0-alpine
HAPROXY_VERSION=3.2-alpine

# ---- scaling: number of platform instances (one tb-core + one tb-rule-engine + one tb-http-transport each).
# Use `make up N=4`, which also sets POOL_CPUSET; the values here only apply when running docker compose by hand.
TB_REPLICAS=1
POOL_CPUSET=4

# ---- fixed resources (README, "Resource layout"). One instance = 1 core of the pool + the three TB_*_MEM below.
# (Three JVMs cannot share 1 GB: an instance needs ~2.5 GB, CPU stays at 1 core per instance like the other platforms.)
# A TB JVM needs ~350-400 MB outside the heap, so heap + metaspace + code cache + direct memory are capped explicitly to
# keep the whole process inside its container limit (otherwise the kernel OOM-kills it).
LB_CPUSET=1
INFRA_CPUSET=2-3
TB_CORE_MEM=1g
TB_CORE_JAVA_OPTS=-Xms512m -Xmx512m -XX:MaxMetaspaceSize=256m -XX:ReservedCodeCacheSize=96m -XX:MaxDirectMemorySize=128m -Xss512k
TB_RULE_ENGINE_MEM=1g
TB_RULE_ENGINE_JAVA_OPTS=-Xms512m -Xmx512m -XX:MaxMetaspaceSize=256m -XX:ReservedCodeCacheSize=96m -XX:MaxDirectMemorySize=128m -Xss512k
TB_HTTP_TRANSPORT_MEM=512m
TB_HTTP_TRANSPORT_JAVA_OPTS=-Xms256m -Xmx256m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=64m -XX:MaxDirectMemorySize=64m -Xss512k
LB_MEM=256m
POSTGRES_MEM=1536m
KAFKA_MEM=1280m
KAFKA_HEAP_OPTS=-Xms768m -Xmx768m
ZOOKEEPER_MEM=512m
ZOOKEEPER_JVMFLAGS=-Xms256m -Xmx256m
VALKEY_MEM=256m

# ---- tuning knobs recorded in every run manifest (TB defaults)
TB_DB_POOL_SIZE=16
TB_SQL_TS_BATCH_SIZE=10000
TB_SQL_TS_BATCH_MAX_DELAY_MS=100
TB_SQL_TS_BATCH_THREADS=3
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_PASSWORD=postgres
TB_LOAD_DEMO=true

# ---- exposure (0.0.0.0 so the separate load-generator machine can reach the LB)
BIND_IP=0.0.0.0
TB_HTTP_PORT=8080
LB_STATS_PORT=8404
