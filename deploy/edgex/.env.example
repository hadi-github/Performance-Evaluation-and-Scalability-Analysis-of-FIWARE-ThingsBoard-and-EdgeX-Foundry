# ---- versions (EdgeX 4.0 "Odesa" LTS)
EDGEX_VERSION=4.0.2
EDGEX_DEVICE_REST_VERSION=4.0.2
EDGEX_POSTGRES_VERSION=16.3-alpine
NATS_VERSION=2.12.9-alpine
HAPROXY_VERSION=3.2-alpine

# ---- build: Go builder image. Where proxy.golang.org is blocked, build an image that sets GOPROXY
# (see README) and point this at it, e.g. GO_BUILDER_BASE=local/golang-goproxy:1.25-alpine3.22
#GO_BUILDER_BASE=golang:1.25-alpine3.22

# ---- scaling: number of platform instances (one core-data + one device-rest each). Use `make up N=4`, which
# also sets POOL_CPUSET; the values here only apply when running docker compose by hand.
EDGEX_REPLICAS=1
POOL_CPUSET=4

# ---- fixed resources (README, "Resource layout"). One instance = 1 core of the pool + both *_MEM below.
LB_CPUSET=1
INFRA_CPUSET=2-3
EDGEX_CORE_DATA_MEM=512m
EDGEX_DEVICE_REST_MEM=512m
LB_MEM=256m
POSTGRES_MEM=1536m
NATS_MEM=256m
CORE_KEEPER_MEM=256m
CORE_METADATA_MEM=256m

# ---- tuning knobs recorded in every run manifest
EDGEX_LOG_LEVEL=WARN
EDGEX_CORE_DATA_DB_MAXCONNS=4
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=512MB

# ---- exposure
BIND_IP=0.0.0.0
EDGEX_DEVICE_REST_PORT=59986
EDGEX_CORE_DATA_PORT=59880
EDGEX_CORE_METADATA_PORT=59881
LB_STATS_PORT=8404
