# IoT benchmark deployment — the ONE file to edit for a new environment.
#
# Everything a deployment needs to reach the two hosts and lay out paths is here.
# Nothing else in the repository needs to change when IPs, ports, users or paths
# move: the scripts, the launcher and the campaign driver all read these values.
#
#   1. cp .env.example .env
#   2. edit .env for your hosts
#   3. scripts/configure-from-env.sh   # validates it and writes the SSH config
#
# .env is git-ignored. .env.example is committed and is the documented default.
#
# ---------------------------------------------------------------------------
# THE TWO HOSTS
# ---------------------------------------------------------------------------
# The SUT runs the platform stacks (ThingsBoard / FIWARE / EdgeX).
# The load generator runs the traffic generator and the sink.
#
# Use an IP or a DNS name. Both are fine; an IP avoids a DNS dependency during
# a long run.
IOTBENCH_SUT_HOST=ramonavm2
IOTBENCH_LOAD_HOST=ramonavm1

# The address the generator connects to (the SUT's own IP, not the SSH alias).
# This is what appears in generated subscriptions and readiness probes.
IOTBENCH_SUT_IP=87.107.191.107
# The address the SUT's platforms push receipts to (the load host's IP).
IOTBENCH_LOAD_IP=87.107.191.32

# ---------------------------------------------------------------------------
# SSH
# ---------------------------------------------------------------------------
IOTBENCH_SSH_USER=root
IOTBENCH_SSH_PORT_SUT=22
IOTBENCH_SSH_PORT_LOAD=22
# Identity file for both hosts. Leave empty to use the ssh agent / default keys.
IOTBENCH_SSH_KEY=~/.ssh/id_ed25519_vps

# Optional jump host. Needed when the load host is not directly reachable from
# the workstation (for example when it is only on the SUT's private network).
# Empty means direct. Format: user@host, optionally with :port.
IOTBENCH_JUMP=

# Where configure-from-env.sh writes the generated SSH config. Every script
# passes this file to ssh/scp via -F, so host-key checking and identity are
# identical on every path.
IOTBENCH_SSH_CONFIG=.iotbench-ssh-config

# ---------------------------------------------------------------------------
# REMOTE LAYOUT
# ---------------------------------------------------------------------------
# Absolute paths on the load host: where deploy-generator.sh puts the checkout
# and where this deployment writes generator results.
#
# These are intentionally different from the built-in defaults. The defaults
# under /root/iot-qual-*-20261105 are the *qualified* testbed's paths, kept so
# that an unconfigured checkout reproduces the published runs exactly. A fresh
# deployment starts clean, so copy this file and use a date-free layout; the
# campaign writes its own evidence local to the repository.
IOTBENCH_LOAD_ROOT=/srv/iot-bench/load
IOTBENCH_REMOTE_RESULTS=/srv/iot-bench/load/results

# ---------------------------------------------------------------------------
# LOCAL OVERRIDES (rarely needed)
# ---------------------------------------------------------------------------
# Use a different .env file than the one at the repository root.
# IOTBENCH_ENV_FILE=/path/to/site.env
#
# Backwards-compatible aliases: older scripts read IOTBENCH_SUT / IOTBENCH_LOAD.
# The *_HOST names above are preferred.
# IOTBENCH_SUT=ramonavm2
# IOTBENCH_LOAD=ramonavm1

# ---------------------------------------------------------------------------
# SYSTEM-UNDER-TEST LAYOUT
# ---------------------------------------------------------------------------
# Where the platform stacks live on the SUT. Set these to the absolute paths on
# your host; `deploy/<platform>/` in this repository is what gets installed
# there. Only used by the shell helpers and the runbook; the launcher resolves
# the same places through the two compose variables below.
IOTBENCH_SUT_ROOT=/srv/iot-bench/sut

# Platform compose files on the SUT (absolute). FIWARE's edgex/ is expected
# beneath the FIWARE directory.
IOTBENCH_TB_COMPOSE=/srv/iot-bench/sut/deploy/thingsboard/compose.yaml
IOTBENCH_FW_DIR=/srv/iot-bench/sut/deploy/fiware
IOTBENCH_EDGEX_DIR=/srv/iot-bench/sut/deploy/edgex

# ---------------------------------------------------------------------------
# CAPTURE
# ---------------------------------------------------------------------------
# Dedicated sink port for a measured run (the exploratory sink uses 18090).
IOTBENCH_SINK_PORT=18091

# ---------------------------------------------------------------------------
# RESOURCE LAYOUT (pre-registered; change only with an owner decision)
# ---------------------------------------------------------------------------
# core 0        OS + Docker + exporters
# cores 2-3     stateful tier
# cores 4..4+N-1  application replicas
# The pre-registered testbed is 8 cores / 16 GB on the SUT and 4 cores / 8 GB
# on the load host. A host with fewer cores cannot run N=4.
#
# Read by the campaign launcher, not by iotbench_config.py: they set the CPU
# pools and replica count the launcher applies and then verifies against the
# live containers.
# IOTBENCH_POOL_CPUSET=4-5
# IOTBENCH_INFRA_CPUSET=2-3
# IOTBENCH_REPLICAS=2
