# Grafana admin password (required). Generate one with:  openssl rand -base64 18
GF_ADMIN_PASSWORD=
# Registry mirror for Docker Hub images (Arvan works from ramonavm1; docker.io is not reachable from Iran)
REGISTRY=docker.arvancloud.ir
PROMETHEUS_VERSION=v3.13.4
GRAFANA_VERSION=12.4.13
NODE_EXPORTER_VERSION=v1.12.0
PROMETHEUS_RETENTION=30d
# size cap of the TSDB; at ~2k series and a 5 s interval a 10-minute run adds well under 100 MB
PROMETHEUS_RETENTION_SIZE=20GB
# Cores for this stack; k6 uses K6_CPUSET=0-2 (workloads/run.sh)
MONITORING_CPUSET=3
PROMETHEUS_MEM=2g
GRAFANA_MEM=512m
GRAFANA_BIND=0.0.0.0
