{
  "uid": "iot-run-review",
  "title": "IoT \u2022 Run review",
  "tags": [
    "iot",
    "run-review"
  ],
  "timezone": "utc",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "Benchmark runs",
        "target": {
          "type": "tags",
          "tags": [
            "benchmark"
          ],
          "limit": 100,
          "matchAny": true
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "platform",
        "label": "platform",
        "type": "custom",
        "query": "thingsboard,fiware,edgex",
        "current": {
          "text": "edgex",
          "value": "edgex"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(bench:service_cpu_cores:rate30s{platform=\"$platform\"}, service)",
          "refId": "A"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0
      },
      {
        "name": "run_id",
        "label": "run (k6 stream)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(k6_http_reqs_total, run_id)",
          "refId": "A"
        },
        "refresh": 2,
        "sort": 2,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Run review \u2022 select one run and an absolute time window",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Read load \u2192 latency \u2192 resources \u2192 health.** Use the exporter link for exact UTC bounds. Green/healthy graphs do not establish PASS: use the run audit and identity reconciliation. Percentiles are windowed diagnostics, never averaged. Exporter context defaults to 60 s before/after measurement; rate panels use 30 s windows."
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Planned vs sent vs acknowledged (messages/s)",
      "description": "planned = step rate from the resolved plan; sent = k6 http_reqs (name=send); ack = generator outcome counter. 30 s rate windows. Diagnostic time series. Infrastructure is time-window scoped, not run-labelled; isolate the platform. Missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (step) (bench:k6_planned_rate{run_id=~\"$run_id\"})",
          "legendFormat": "planned, step {{step}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (scenario) (bench:k6_send_requests:rate30s{run_id=~\"$run_id\"})",
          "legendFormat": "sent {{scenario}}",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (step) (bench:k6_outcome:rate30s{run_id=~\"$run_id\",outcome=\"ack_success\"})",
          "legendFormat": "ack_success, step {{step}}",
          "refId": "C",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Explicit failures, unknown outcomes, dropped iterations (per s)",
      "description": "Any dropped iteration makes the run INVALID (benchctl health). No data = no such events in the stream, or no stream: check the run's health.json. Diagnostic time series. Infrastructure is time-window scoped, not run-labelled; isolate the platform. Missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome, step) (bench:k6_outcome:rate30s{run_id=~\"$run_id\",outcome=~\"explicit_failure|unknown\"})",
          "legendFormat": "{{outcome}} step {{step}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (scenario) (bench:k6_dropped_iterations:rate30s{run_id=~\"$run_id\"})",
          "legendFormat": "dropped {{scenario}}",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (step) (bench:k6_outcome:rate30s{run_id=~\"$run_id\",outcome=\"early\"})",
          "legendFormat": "early sends step {{step}}",
          "refId": "C",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Send lag p99 (actual JS send \u2212 scheduled) per step, ms",
      "description": "k6 Trend g_lag_ms{s}: exact p99 over the step's samples so far (computed by k6, not mergeable). Gate: p99 <= 10 ms per step, evaluated offline from the end-of-run summary (health.json). Diagnostic time series. Infrastructure is time-window scoped, not run-labelled; isolate the platform. Missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "bench:k6_latency_p99_ms{run_id=~\"$run_id\",histogram=\"lag\"}",
          "legendFormat": "step {{step}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Acknowledgement latency p99 (HTTP response \u2212 scheduled) per step and minute, ms",
      "description": "k6 Trend g_ack_ms{s,m}, m = minute of the step by scheduled send time (0-based). Starts at the scheduled time (includes send lag). Acknowledgement, not persistence or sink observation. Diagnostic time series. Infrastructure is time-window scoped, not run-labelled; isolate the platform. Missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "bench:k6_latency_p99_ms{run_id=~\"$run_id\",histogram=\"ack\"}",
          "legendFormat": "step {{step}} min {{minute}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Platform CPU: application vs supporting tier (cores)",
      "description": "Core-equivalents (CPU-seconds per second), not percent. Platform boundary = application + supporting tier incl. HAProxy, databases, brokers; exporters excluded (tier=monitoring). Diagnostic time series. Infrastructure is time-window scoped, not run-labelled; isolate the platform. Missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "bench:tier_cpu_cores:rate30s{platform=\"$platform\",tier=~\"application|supporting\"}",
          "legendFormat": "{{tier}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 40,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU per container / replica (cores)",
      "description": " Diagnostic time series. Infrastructure is time-window scoped, not run-labelled; isolate the platform. Missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "bench:container_cpu_cores:rate30s{platform=\"$platform\",service=~\"$service\"}",
          "legendFormat": "{{container}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memory working set / limit per container",
      "description": " Diagnostic time series. Infrastructure is time-window scoped, not run-labelled; isolate the platform. Missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (container) (container_memory_working_set_bytes{job=\"cadvisor\",platform=\"$platform\",service=~\"$service\"}) / max by (container) (container_spec_memory_limit_bytes{job=\"cadvisor\",platform=\"$platform\",service=~\"$service\"} > 0)",
          "legendFormat": "{{container}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Container starts and OOM kills",
      "description": "Starts from cAdvisor's container_start_time_seconds (covers manual restarts and recreation; Docker's RestartCount only counts restart-policy restarts). Platform restarts/OOM are platform evidence, not automatically an invalid run. Diagnostic time series. Infrastructure is time-window scoped, not run-labelled; isolate the platform. Missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (changes(container_start_time_seconds{job=\"cadvisor\",platform=\"$platform\"}[10m]))",
          "legendFormat": "starts in 10 min {{container}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (container) (bench_container_oom_killed{platform=\"$platform\"})",
          "legendFormat": "last exit OOM {{container}}",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (increase(container_oom_events_total{job=\"cadvisor\",platform=\"$platform\"}[5m]))",
          "legendFormat": "OOM events 5m {{container}}",
          "refId": "C",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Load host pressure (ramonavm1): busy per core",
      "description": "k6 runs on cores 0-2, Prometheus/Grafana/cAdvisor on core 3. Diagnostic time series. Infrastructure is time-window scoped, not run-labelled; isolate the platform. Missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "bench:host_core_busy:ratio30s{host=\"ramonavm1\"}",
          "legendFormat": "cpu{{cpu}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Kafka consumer-group lag (ThingsBoard)",
      "description": "kafka-exporter: offset lag of each consumer group = messages produced but not yet consumed by that group. A backlog signal, not proof of persistence. Diagnostic time series. Infrastructure is time-window scoped, not run-labelled; isolate the platform. Missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag and on (instance) (up{job=\"kafka\"} == 1))",
          "legendFormat": "{{consumergroup}} {{topic}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scrape targets (1 = up, 0 = down; a missing row = never scraped)",
      "description": "Prometheus scrape health. Exporters of platforms that are not running are expected to be 0. A healthy scrape says nothing about benchmark validity. Diagnostic time series. Infrastructure is time-window scoped, not run-labelled; isolate the platform. Missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (job, instance, host) (up)",
          "legendFormat": "{{job}} {{instance}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "merge"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Monitoring stack resources",
      "description": " Diagnostic time series. Infrastructure is time-window scoped, not run-labelled; isolate the platform. Missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(process_cpu_seconds_total{job=~\"prometheus|grafana\"}[$__rate_interval])",
          "legendFormat": "{{job}} CPU cores",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{job=\"loadgen-cadvisor\",service=~\"prometheus|grafana|cadvisor|node-exporter\"}[$__rate_interval]))",
          "legendFormat": "{{container}} cores (cAdvisor)",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
