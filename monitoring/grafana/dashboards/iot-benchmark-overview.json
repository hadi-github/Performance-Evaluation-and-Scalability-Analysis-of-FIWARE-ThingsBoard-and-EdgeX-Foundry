  {
   "id": 12,
   "type": "timeseries",
   "title": "Memory working set / limit",
   "description": "Above ~90% the kernel OOM-kills the container (see next panel).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (container) (container_memory_working_set_bytes{job=\"cadvisor\",project=\"$project\"}) / max by (container) (container_spec_memory_limit_bytes{job=\"cadvisor\",project=\"$project\"} > 0)",
     "legendFormat": "{{container}}",
     "refId": "A",
     "range": true
