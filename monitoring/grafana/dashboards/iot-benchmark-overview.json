{
 "uid": "iot-bench-overview",
 "title": "IoT benchmark overview",
 "tags": [
  "iot-bench"
 ],
 "timezone": "utc",
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "schemaVersion": 39,
 "editable": true,
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "orange",
    "name": "Benchmark runs",
    "target": {
     "type": "tags",
     "tags": [
      "benchmark"
     ],
     "limit": 100,
     "matchAny": true
    }
   }
  ]
 },
 "templating": {
  "list": [
   {
    "name": "project",
    "label": "platform",
    "type": "custom",
    "query": "thingsboard : tb,fiware : fiware,edgex : edgex",
    "current": {
     "text": "fiware",
     "value": "fiware"
    },
    "options": [],
    "hide": 0
   },
   {
    "name": "testid",
    "label": "test id",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(k6_http_reqs_total{platform=\"${project:text}\"}, testid)",
     "refId": "A"
    },
    "refresh": 2,
    "sort": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Load (k6 on ramonavm1)",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 0
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Telemetry requests/s by phase",
   "description": "Achieved arrival rate. The steady phase must equal the target rate (run.sh checks within 1%).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (testid, scenario) (rate(k6_http_reqs_total{testid=~\"$testid\",name=\"send\"}[$__rate_interval]))",
     "legendFormat": "{{scenario}} {{testid}}",
     "refId": "A",
     "range": true
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Latency (steady phase)",
   "description": "Per push interval (5 s) percentiles reported by k6.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (testid) (k6_http_req_duration_p50{testid=~\"$testid\",name=\"send\",scenario=\"steady\"})",
     "legendFormat": "p50 {{testid}}",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (testid) (k6_http_req_duration_p95{testid=~\"$testid\",name=\"send\",scenario=\"steady\"})",
     "legendFormat": "p95 {{testid}}",
     "refId": "B",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (testid) (k6_http_req_duration_p99{testid=~\"$testid\",name=\"send\",scenario=\"steady\"})",
     "legendFormat": "p99 {{testid}}",
     "refId": "C",
     "range": true
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Errors and dropped iterations /s",
   "description": "Dropped iterations mean the generator could not hold the rate: the run is INVALID.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (testid, status) (rate(k6_http_reqs_total{testid=~\"$testid\",name=\"send\",expected_response=\"false\"}[$__rate_interval]))",
     "legendFormat": "HTTP {{status}} {{testid}}",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (testid) (rate(k6_dropped_iterations_total{testid=~\"$testid\"}[$__rate_interval]))",
     "legendFormat": "dropped {{testid}}",
     "refId": "B",
     "range": true
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
