       "mode": "none"
      },
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Explicit failures, unknown outcomes, dropped iterations (per s)",
   "description": "Any dropped iteration makes the run INVALID (benchctl health). No data = no such events in the stream, or no stream: check the run's health.json.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (outcome, step) (bench:k6_outcome:rate30s{run_id=~\"$run_id\",outcome=~\"explicit_failure|unknown\"})",
     "legendFormat": "{{outcome}} step {{step}}",
     "refId": "A",
     "range": true,
     "instant": false,
     "format": "time_series"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (scenario) (bench:k6_dropped_iterations:rate30s{run_id=~\"$run_id\"})",
     "legendFormat": "dropped {{scenario}}",
     "refId": "B",
     "range": true,
     "instant": false,
     "format": "time_series"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (step) (bench:k6_outcome:rate30s{run_id=~\"$run_id\",outcome=\"early\"})",
     "legendFormat": "early sends step {{step}}",
     "refId": "C",
     "range": true,
     "instant": false,
     "format": "time_series"
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 12,
