  {
   "id": 13,
   "type": "timeseries",
   "title": "OOM kills and container (re)starts",
   "description": "Any non-zero value during a run makes it INVALID (run.sh checks this).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (container) (increase(container_oom_events_total{job=\"cadvisor\",project=\"$project\"}[1m]))",
     "legendFormat": "OOM {{container}}",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (container) (changes(container_start_time_seconds{job=\"cadvisor\",project=\"$project\"}[1m]))",
     "legendFormat": "start {{container}}",
     "refId": "B",
