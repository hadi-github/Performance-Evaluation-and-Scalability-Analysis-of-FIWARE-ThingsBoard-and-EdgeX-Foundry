  {
   "id": 15,
   "type": "timeseries",
   "title": "Send lag (actual JS send \u2212 scheduled), bucket counts/s by upper edge (ms)",
   "description": "Non-cumulative bucket rates from the generator histogram (edges from the plan, 'inf' = overflow, 0p5 = 0.5). Gate: p99 <= 10 ms per step, evaluated offline from exact counts (health.json).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (le) (bench:k6_latency_bucket:rate30s{run_id=~\"$run_id\",histogram=\"lag\"})",
     "legendFormat": "le {{le}}",
     "refId": "A",
     "range": true,
     "instant": false,
     "format": "time_series"
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 41
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 40,
      "stacking": {
       "mode": "normal"
      },
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Acknowledgement latency (HTTP response \u2212 scheduled), bucket counts/s (ms)",
   "description": "Starts at the scheduled time (includes send lag). This is acknowledgement, not persistence or sink observation. The provisional P1 platform budget is 500 ms (not frozen).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (le) (bench:k6_latency_bucket:rate30s{run_id=~\"$run_id\",histogram=\"ack\"})",
     "legendFormat": "le {{le}}",
     "refId": "A",
     "range": true,
     "instant": false,
     "format": "time_series"
