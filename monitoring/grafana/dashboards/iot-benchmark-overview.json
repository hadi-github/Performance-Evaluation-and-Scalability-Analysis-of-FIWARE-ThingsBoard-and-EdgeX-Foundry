     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 5,
   "type": "table",
   "title": "Platform containers (state from docker inspect, every 10 s)",
   "description": "bench_container_info from monitoring/exporters/container-info.sh (textfile collector). cpuset = pinned CPUs. Absent = the timer is not installed on the SUT.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (service, container, cpuset, status) (bench_container_info{platform=\"$platform\"})",
     "legendFormat": "",
     "refId": "A",
     "range": false,
     "instant": true,
     "format": "table"
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "transformations": [
    {
     "id": "merge"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Container starts and OOM kills",
   "description": "Starts from cAdvisor's container_start_time_seconds (covers manual restarts and recreation; Docker's RestartCount only counts restart-policy restarts). Platform restarts/OOM are platform evidence, not automatically an invalid run.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (container) (changes(container_start_time_seconds{job=\"cadvisor\",platform=\"$platform\"}[10m]))",
     "legendFormat": "starts in 10 min {{container}}",
     "refId": "A",
     "range": true,
     "instant": false,
     "format": "time_series"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (container) (bench_container_oom_killed{platform=\"$platform\"})",
     "legendFormat": "last exit OOM {{container}}",
     "refId": "B",
     "range": true,
     "instant": false,
     "format": "time_series"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (container) (increase(container_oom_events_total{job=\"cadvisor\",platform=\"$platform\"}[5m]))",
     "legendFormat": "OOM events 5m {{container}}",
     "refId": "C",
     "range": true,
     "instant": false,
     "format": "time_series"
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 12,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Load host pressure (ramonavm1): busy per core",
   "description": "k6 runs on cores 0-2, Prometheus/Grafana/cAdvisor on core 3.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "bench:host_core_busy:ratio30s{host=\"ramonavm1\"}",
     "legendFormat": "cpu{{cpu}}",
     "refId": "A",
     "range": true,
     "instant": false,
     "format": "time_series"
    }
   ],
   "gridPos": {
    "w": 12,
