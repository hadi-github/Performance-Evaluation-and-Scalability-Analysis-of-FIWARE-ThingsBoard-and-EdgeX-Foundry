    }
   }
  },
  {
   "id": 9,
   "type": "row",
   "title": "2. Workload delivery (k6 remote-write stream; present only for runs started with benchctl -prom-rw)",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 24
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Planned vs sent vs acknowledged (messages/s)",
   "description": "planned = step rate from the resolved plan; sent = k6 http_reqs (name=send); ack = generator outcome counter. 30 s rate windows.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (step) (bench:k6_planned_rate{run_id=~\"$run_id\"})",
     "legendFormat": "planned, step {{step}}",
     "refId": "A",
     "range": true,
     "instant": false,
     "format": "time_series"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (scenario) (bench:k6_send_requests:rate30s{run_id=~\"$run_id\"})",
     "legendFormat": "sent {{scenario}}",
     "refId": "B",
     "range": true,
     "instant": false,
     "format": "time_series"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (step) (bench:k6_outcome:rate30s{run_id=~\"$run_id\",outcome=\"ack_success\"})",
     "legendFormat": "ack_success, step {{step}}",
     "refId": "C",
     "range": true,
     "instant": false,
     "format": "time_series"
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 25
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
