{
 "uid": "iot-bench-overview",
 "title": "IoT benchmark overview",
 "tags": [
  "iot-bench"
 ],
 "timezone": "utc",
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "schemaVersion": 39,
 "editable": true,
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "orange",
    "name": "Benchmark runs",
    "target": {
     "type": "tags",
     "tags": [
      "benchmark"
     ],
     "limit": 100,
     "matchAny": true
    }
   }
  ]
 },
 "templating": {
  "list": [
   {
    "name": "platform",
    "label": "platform",
    "type": "custom",
    "query": "thingsboard,fiware,edgex",
    "current": {
     "text": "edgex",
     "value": "edgex"
    },
    "options": [],
    "hide": 0
   },
   {
    "name": "service",
    "label": "service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(bench:service_cpu_cores:rate30s{platform=\"$platform\"}, service)",
     "refId": "A"
    },
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "hide": 0
   },
   {
    "name": "run_id",
    "label": "run (k6 stream)",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(k6_http_reqs_total, run_id)",
     "refId": "A"
    },
    "refresh": 2,
    "sort": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "1. Context and monitoring health (operational status, not a run verdict)",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 0
   }
  },
  {
   "id": 2,
   "type": "table",
   "title": "Scrape targets (1 = up, 0 = down; a missing row = never scraped)",
   "description": "Prometheus scrape health. Exporters of platforms that are not running are expected to be 0. A healthy scrape says nothing about benchmark validity.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (job, instance, host) (up)",
     "legendFormat": "{{job}} {{instance}}",
     "refId": "A",
     "range": false,
     "instant": true,
     "format": "table"
    }
   ],
   "gridPos": {
    "w": 8,
    "h": 8,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "transformations": [
    {
     "id": "merge"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Scrape duration",
   "description": "Per scrape (interval 5 s, timeout 4 s).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (job) (scrape_duration_seconds)",
     "legendFormat": "{{job}}",
     "refId": "A",
     "range": true,
     "instant": false,
     "format": "time_series"
    }
   ],
   "gridPos": {
    "w": 8,
    "h": 8,
    "x": 8,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Samples per scrape",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (job) (scrape_samples_scraped)",
     "legendFormat": "{{job}}",
     "refId": "A",
     "range": true,
     "instant": false,
     "format": "time_series"
    }
   ],
   "gridPos": {
    "w": 8,
    "h": 8,
    "x": 16,
