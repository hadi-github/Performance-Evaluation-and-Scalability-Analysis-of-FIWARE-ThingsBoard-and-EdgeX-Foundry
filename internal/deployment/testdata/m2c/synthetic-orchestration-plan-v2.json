  "execution_blocked": true,
  "stages": [
    {
      "stage": "pre_deploy_inventory",
      "purpose": "SYNTHETIC M2c fixture; Read and validate the declared descriptor, inventory and unchanged stack files without contacting anything.",
      "permissible_actions": [
        "Read",
        "Validate",
        "Attest"
      ],
      "execution_blocked_here": false,
      "expected_evidence": [
        "descriptor",
        "inventory",
        "compose",
        "env",
        "makefile",
        "protocol",
        "profile"
      ]
    },
    {
      "stage": "provision_on_sut",
      "purpose": "SYNTHETIC M2c fixture; Reference the future provisioned replica set. Provisioning is not performed by M2b.",
      "permissible_actions": [
        "Validate",
        "Attest"
      ],
      "blocked_actions": [
        "Apply",
        "Scale"
      ],
      "execution_blocked_here": true,
      "expected_evidence": [
        "orchestration_plan"
      ]
    },
    {
      "stage": "dry_run_render",
      "purpose": "SYNTHETIC M2c fixture; Render the deterministic plan and attestation from caller-supplied documents.",
      "permissible_actions": [
        "Read",
        "Validate",
        "RenderDryRun",
        "Attest"
      ],
      "execution_blocked_here": false,
      "expected_evidence": [
        "orchestration_plan"
      ]
    },
    {
      "stage": "apply",
      "purpose": "SYNTHETIC M2c fixture; Reference only: a future, separately authorized deployment would be applied here.",
      "permissible_actions": [
        "Attest"
      ],
      "blocked_actions": [
        "Apply",
        "Scale",
        "Restart",
        "Stop"
      ],
      "execution_blocked_here": true,
      "expected_evidence": [
        "orchestration_plan"
      ]
    },
    {
      "stage": "validate_health",
      "purpose": "SYNTHETIC M2c fixture; Compare caller-supplied health and inventory attestations with the declaration.",
      "permissible_actions": [
        "Read",
        "Validate",
        "Attest"
      ],
      "execution_blocked_here": false,
      "expected_evidence": [
        "inventory",
        "monitoring_export",
        "log"
      ]
    },
    {
      "stage": "evidence",
      "purpose": "SYNTHETIC M2c fixture; Package hashes, logs and preserved ledgers without rewriting any prior artifact.",
      "permissible_actions": [
        "Read",
        "Validate",
        "Attest"
      ],
      "execution_blocked_here": false,
      "expected_evidence": [
        "run_manifest",
        "k6_summary",
        "sink_ledger",
        "adapter_ledger",
        "receipt_ledger",
        "sha256sums",
        "packet"
      ]
    },
    {
      "stage": "rollback",
      "purpose": "SYNTHETIC M2c fixture; Reference only: restoration rules and the interrupt exception; no restoration is executed.",
      "permissible_actions": [
        "Read",
        "Validate",
        "Attest"
      ],
      "blocked_actions": [
        "Restart",
        "Stop",
        "Reset",
        "Delete"
      ],
      "execution_blocked_here": true,
      "expected_evidence": [
        "run_manifest",
        "log"
      ]
    }
  ],
